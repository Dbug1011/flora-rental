# Flora Dress Rental — environment variables (placeholders only; never commit real values)
#
# BOOKING_SERVICE_MODE
#   mock        Preview with sample data. Nothing is saved; every page shows a "Preview mode" banner.
#   apps_script Real bookings through the Google Apps Script booking service (needs the two values below).
#   (unset)     Site shows "reservations open soon" and accepts no requests.
BOOKING_SERVICE_MODE=mock

# Web app URL from Apps Script → Deploy → Manage deployments (ends in /exec)
APPS_SCRIPT_URL=https://script.google.com/macros/s/REPLACE_WITH_DEPLOYMENT_ID/exec

# Shared secret: in the Sheet, Flora menu → "Show API secret for Vercel". At least 24 characters.
APPS_SCRIPT_SECRET=REPLACE_WITH_SECRET_FROM_SHEET
